# Telegram Bot
BOT_TOKEN=your_bot_token_here
# REQUIRED. Comma-separated chat ids. Empty = the bot responds nowhere.
ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
# Private chats: open (any user) or allowlist (user/chat ID must be listed above)
PRIVATE_ACCESS=allowlist
PRIVATE_USER_LIMIT_PER_HOUR=10
PRIVATE_GLOBAL_LIMIT_PER_DAY=500
MAX_SOURCE_CHARS=3000

# LLM — OpenRouter / poolside laguna-s-2.1 (free)
# key: https://openrouter.ai/settings/keys
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=poolside/laguna-s-2.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3
# response_format=json_object is not advertised for this model and can return 400.
# Leave false; the client parses JSON when present and falls back to plain text.
LLM_JSON_MODE=false

# Rate limiting. Free OpenRouter models are throttled hard (~20 req/min),
# so keep the chat limit low if you hit 429s.
RATE_LIMIT_PER_USER_PER_MINUTE=20
RATE_LIMIT_PER_CHAT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO